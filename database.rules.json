{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },
        "pub": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 8)"
          }
        },
        "priv": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
          }
        },
        "act": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)"
          }
        },
        "draft": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)"
          }
        },
        "online": {
          ".read": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)"
          }
        }
      }
    }
  }
}
